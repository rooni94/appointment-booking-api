generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  active
  cancelled
}

model Slot {
  id       String    @id @default(uuid()) @db.Uuid
  startsAt DateTime
  endsAt   DateTime
  bookings Booking[]

  @@index([startsAt, id])
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  slotId        String        @db.Uuid
  customerName  String
  customerEmail String
  status        BookingStatus @default(active)
  slot          Slot          @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([slotId])
}
